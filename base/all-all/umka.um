type MobjInfo* = struct {
	doomedNum: int32
	spawnState: int32
	spawnHealth: int32
	seeState: int32
	seeSound: int32
	reactionTime: int32
	attackSound: int32
	painState: int32
	painChance: int32
	painSound: int32
	meleeState: int32
	missileState: int32
	deathState: int32
	xdeathState: int32
	deathSound: int32
	speed: int32
	radius: int32
	height: int32
	mass: int32
	damage: int32
	activeSound: int32
	flags: int32
	raiseState: int32
	
	// DEHEXTRA
	droppedItem: int32 // mobjtype_t

	// MBF21
	flags2: int32
	infightingGroup: int32
	projectileGroup: int32
	splashGroup: int32
	ripSound: int32
	altSpeed: int32
	meleeRange: int32

	// MBF2Y
	obituary: str
	obituaryMelee: str
	obituarySelf: str

	// Woof
	flagsExtra: int32
	bloodColor: int32
}

const noAltSpeed* = -1
const zmt_undefined* = -2

fn getState(stateNum: int32): ^State

// end info

fn main() {
	for i := s_pistol1; i <= s_pistolflash; i++ {
		var state: ^State = getState(i)

		state.tics /= 2
	}
}
