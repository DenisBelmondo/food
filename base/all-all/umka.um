type State* = struct {
	sprite: int32
	frame: int32
	tics: int32
	action: ^void
	nextState: int32
	misc1: int32
	misc2: int32
	args: [maxStateArgs]int32
	tranmap: ^uint8
	flags: int32
}

type FrameFlags* = enum {
	fullBright = 0x8000
	frameMask = 0x7fff
}

type StateFlags* = enum {
	skill5Fast = 0x00000001
}

